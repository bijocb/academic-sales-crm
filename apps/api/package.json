{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate >/dev/null && tsc -p tsconfig.json --noEmit",
    "dev": "prisma generate && tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch --enable-source-maps dist/main.js)",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "test": "jest --runInBand",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env prisma/seed-demo.ts",
    "db:deploy": "tsx scripts/migrate.ts --seed",
    "vercel-build": "prisma generate && tsc -p tsconfig.build.json && tsx scripts/migrate.ts --seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@crm/contracts": "workspace:*",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "libphonenumber-js": "1.12.43",
    "luxon": "3.7.2",
    "nestjs-pino": "4.4.1",
    "nodemailer": "10.6.1",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.12",
    "@swc/core": "1.15.1",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.6",
    "@types/node": "22.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "jest": "30.2.0",
    "pino-pretty": "13.1.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
