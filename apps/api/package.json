{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate >/dev/null && tsc -p tsconfig.json --noEmit",
    "dev": "prisma generate && tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch --enable-source-maps dist/main.js)",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate deploy && bash scripts/setup-db-role.sh",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env prisma/seed-demo.ts"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "nestjs-pino": "4.4.1",
    "nodemailer": "7.0.10",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.9",
    "@swc/core": "1.15.1",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.1",
    "@types/nodemailer": "7.0.3",
    "@types/supertest": "6.0.3",
    "jest": "30.2.0",
    "pino-pretty": "13.1.2",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
