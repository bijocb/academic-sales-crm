  signatureValid Boolean  @map("signature_valid")
  payload        Json
  attemptId      String?  @map("attempt_id") @db.Uuid
  result         String
  receivedAt     DateTime @map("received_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("payment_events")
}

/// Append-only: verified money only. Never edited or deleted (rule 4).
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  brandId        String        @map("brand_id") @db.Uuid
  admissionId    String        @map("admission_id") @db.Uuid
  planId         String        @map("plan_id") @db.Uuid
  attemptId      String?       @unique @map("attempt_id") @db.Uuid
  amountMinor    BigInt        @map("amount_minor")
  currency       Currency
  method         PaymentMethod
  reference      String?
  receiptNumber  String        @map("receipt_number")
  verification   String
  verifiedById   String?       @map("verified_by_id") @db.Uuid
  receivedAt     DateTime      @map("received_at") @db.Timestamptz(3)
  recordedAt     DateTime      @map("recorded_at") @db.Timestamptz(3)
  notes          String?

  @@unique([organizationId, receiptNumber])
  @@unique([organizationId, id])
  @@index([organizationId, admissionId, receivedAt])
  @@index([organizationId, brandId, receivedAt])
  @@map("payments")
}

/// Immutable refund request; its life is in refund_events.
model Refund {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  admissionId    String   @map("admission_id") @db.Uuid
  amountMinor    BigInt   @map("amount_minor")
  currency       Currency
  reason         String
  requestedById  String?  @map("requested_by_id") @db.Uuid
  requestedAt    DateTime @map("requested_at") @db.Timestamptz(3)

  @@unique([organizationId, id])
  @@index([organizationId, paymentId])
  @@map("refunds")
}

/// Append-only: APPROVED / REJECTED / PAID decisions on a refund.
model RefundEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  refundId       String    @map("refund_id") @db.Uuid
  type           String
  note           String?
  method         String?
  reference      String?
  paidOn         DateTime? @map("paid_on") @db.Date
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)

  @@index([organizationId, refundId, occurredAt])
  @@map("refund_events")
}

// ---------------------------------------------------------------- Phase 13

enum TargetMetric {
  ASSIGNED
  CONTACTED
  COUNSELLING
  ADMISSIONS
  REVENUE
  COLLECTIONS
}

enum TargetScope {
  ORGANIZATION
  BRAND
  TEAM
  USER
}

enum IncentiveBasis {
  PER_ADMISSION
  PERCENT_OF_COLLECTIONS
}

enum IncentiveRunStatus {
  DRAFT
  APPROVED
}

model Target {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  scope          TargetScope
  brandId        String?      @map("brand_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  courseId       String?      @map("course_id") @db.Uuid
  metric         TargetMetric
  periodStart    DateTime     @map("period_start") @db.Date
  periodEnd      DateTime     @map("period_end") @db.Date
  value          BigInt
  currency       Currency?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, periodStart, periodEnd])
  @@map("targets")
}

/// Manually entered marketing spend per campaign and month (O-10: no ad-platform sync yet).
model AdSpend {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  campaignId     String   @map("campaign_id") @db.Uuid
  month          DateTime @db.Date
  amountMinor    BigInt   @map("amount_minor")
  currency       Currency
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([campaignId, month])
  @@map("ad_spend")
}

/// Versioned incentive rules: a new version is a new row; old versions stay for approved runs.
model IncentiveRule {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  brandId              String         @map("brand_id") @db.Uuid
  name                 String
  version              Int
  basis                IncentiveBasis
  amountMinor          BigInt?        @map("amount_minor")
  percentBp            Int?           @map("percent_bp")
  currency             Currency
  thresholdCount       Int            @default(0) @map("threshold_count")
  capMinor             BigInt?        @map("cap_minor")
  excludedCourseIds    String[]       @default([]) @map("excluded_course_ids") @db.Uuid
  firstContactSharePct Int            @default(50) @map("first_contact_share_pct")
  effectiveFrom        DateTime       @map("effective_from") @db.Date
  effectiveTo          DateTime?      @map("effective_to") @db.Date
  active               Boolean        @default(true)
  createdById          String?        @map("created_by_id") @db.Uuid
  createdAt            DateTime       @map("created_at") @db.Timestamptz(3)

  @@unique([brandId, name, version])
  @@unique([organizationId, id])
  @@map("incentive_rules")
}

model IncentiveRun {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  brandId        String             @map("brand_id") @db.Uuid
  ruleId         String             @map("rule_id") @db.Uuid
  periodStart    DateTime           @map("period_start") @db.Date
  periodEnd      DateTime           @map("period_end") @db.Date
  status         IncentiveRunStatus @default(DRAFT)
  totalMinor     BigInt             @map("total_minor")
  currency       Currency
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @map("created_at") @db.Timestamptz(3)
  approvedById   String?            @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?          @map("approved_at") @db.Timestamptz(3)

  @@unique([organizationId, id])
  @@index([organizationId, brandId, periodStart])
  @@map("incentive_runs")
}

/// Append-only calculation lines with their inputs (FR-016: never silently recalculated).
model IncentiveLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  kind           String
  amountMinor    BigInt   @map("amount_minor")
  currency       Currency
  inputs         Json
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, runId])
  @@index([organizationId, userId])
  @@map("incentive_lines")
}

// ------------------------------------------------------------------ Phase 14: AI assistance

/// Per-brand AI switches and thresholds (A-045). Off by default.
model AiSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  brandId            String   @unique @map("brand_id") @db.Uuid
  enabled            Boolean  @default(false)
  scoringEnabled     Boolean  @default(true) @map("scoring_enabled")
  nextActionsEnabled Boolean  @default(true) @map("next_actions_enabled")
  highThresholdBp    Int      @default(2500) @map("high_threshold_bp")
  mediumThresholdBp  Int      @default(1000) @map("medium_threshold_bp")
  minTrainingSize    Int      @default(50) @map("min_training_size")
  updatedById        String?  @map("updated_by_id") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_settings")
}

/// Trained model versions (append-only).
model AiModel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  version        Int
  sampleSize     Int      @map("sample_size")
  positives      Int
  usable         Boolean
  stats          Json
  trainedAt      DateTime @map("trained_at") @db.Timestamptz(3)

  @@unique([brandId, version])
  @@unique([organizationId, id])
  @@map("ai_models")
}

/// Lead score history (append-only); a row is written only when the result changes.
model LeadScore {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  modelId        String?  @map("model_id") @db.Uuid
  modelVersion   String   @map("model_version")
  method         String
  score          Int
  band           String
  probabilityBp  Int?     @map("probability_bp")
  confidence     String
  factors        Json
  computedAt     DateTime @map("computed_at") @db.Timestamptz(3)

  @@unique([organizationId, id])
  @@index([organizationId, leadId, computedAt])
  @@map("lead_scores")
}

/// Human overrides of the priority band (append-only, FR-006).
model LeadScoreOverride {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  scoreId        String?  @map("score_id") @db.Uuid
  band           String
  reason         String
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, leadId, createdAt])
  @@map("lead_score_overrides")
}

/// Accepted / dismissed next-best-action suggestions (append-only).
model AiSuggestionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  kind           String
  action         String
  reason         String?
  detail         Json?
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, leadId, createdAt])
  @@map("ai_suggestion_events")
}

// ------------------------------------------------------------------ Meta Lead Ads (A-047)

/// A Facebook page connected for Lead Ads. The page access token is stored encrypted (AES-256-GCM, SECRETS_KEY).
model MetaConnection {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  sourceId       String    @map("source_id") @db.Uuid
  pageId         String    @unique @map("page_id")
  pageName       String    @map("page_name")
  tokenSealed    String    @map("token_sealed")
  status         String    @default("ACTIVE")
  subscribed     Boolean   @default(false)
  lastLeadAt     DateTime? @map("last_lead_at") @db.Timestamptz(3)
  lastError      String?   @map("last_error")
  lastErrorAt    DateTime? @map("last_error_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, id])
  @@index([organizationId, brandId])
  @@map("meta_connections")
}

/// A phone that receives push notifications for a user (mobile app, Expo push token).
model PushDevice {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  token          String    @unique
  platform       String
  appVersion     String?   @map("app_version")
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @map("last_seen_at") @db.Timestamptz(3)
  disabledAt     DateTime? @map("disabled_at") @db.Timestamptz(3)

  @@index([organizationId, userId])
  @@map("push_devices")
}
