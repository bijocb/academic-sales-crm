# Copy to .env (root) for local development. Never commit real values.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# App connects as the non-superuser role crm_app (subject to row-level security).
APP_DATABASE_URL=postgresql://crm_app:change-me-app@localhost:5432/crm
# Migrations run as the database owner.
MIGRATION_DATABASE_URL=postgresql://postgres:change-me-owner@localhost:5432/crm
# Password applied to crm_app by `pnpm db:setup-role` (local/CI only).
CRM_APP_DB_PASSWORD=change-me-app

REDIS_URL=redis://localhost:6379

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# SMTP for invites/password reset. Local: Mailpit (smtp://localhost:1025, UI http://localhost:8025).
# If empty in development, emails are written to the API log (never allowed in production).
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Academic CRM <no-reply@example.com>"

# First platform admin created by `pnpm db:seed`
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=

# Web
API_INTERNAL_URL=http://localhost:4000
